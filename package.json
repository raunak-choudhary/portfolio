{
  "name": "dynamic-portfolio",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://www.raunakchoudhary.com",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.106.2",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.5",
    "react-scripts": "5.0.1",
    "recharts": "^2.15.4",
    "three": "^0.170.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:production": "sh -ac '. ./.env.production; INLINE_RUNTIME_CHUNK=false react-scripts build'",
    "build:prod": "REACT_APP_ENV=production react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "serve": "npx serve -s build -l 3000",
    "analyze": "npm run build && npx source-map-explorer 'build/static/js/*.js'",
    "optimize": "npm run build && npm run analyze",
    "build:e2e": "INLINE_RUNTIME_CHUNK=false REACT_APP_ANALYTICS_ENABLED=false react-scripts build",
    "test:tools": "node --test \"scripts/**/*.test.mjs\" \"e2e/**/*.test.mjs\"",
    "e2e": "playwright test e2e/contract.spec.mjs",
    "capture": "node scripts/capture-site.mjs",
    "compare": "node scripts/compare-captures.mjs",
    "fixtures:record": "node --env-file=.env.development.local scripts/record-fixtures.mjs",
    "scan:bundle": "node scripts/scan-bundle.mjs --root build",
    "check:csp": "node scripts/check-csp.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs --root build",
    "admin:login": "node scripts/admin-login-capture.mjs",
    "admin:open": "node scripts/admin-open.mjs",
    "test:functions": "cd supabase/functions && deno test && deno lint"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.58.0"
  }
}
