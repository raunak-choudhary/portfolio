# Environment template for the portfolio front end.
#
# Copy to `.env.development.local` for `npm start` and to `.env.production`
# for `npm run build:production`. Never commit the copies.
#
# Everything prefixed REACT_APP_ is compiled into the public JavaScript
# bundle and readable by anyone who visits the site. Only values that are
# public by design belong here. Server-side keys (the Supabase secret key,
# the Resend API key) live in Supabase Edge Function secrets, never in any
# file Create React App reads.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
REACT_APP_SUPABASE_URL=

# Supabase public key. Use the publishable key (sb_publishable_...) once it
# exists; the legacy anon JWT is accepted until the key cutover.
REACT_APP_SUPABASE_ANON_KEY=

# Visitor analytics. Tracking runs only when this is exactly "true".
# Production sets true; local development, tests and CI leave it false.
REACT_APP_ANALYTICS_ENABLED=false

# Build settings read by react-scripts.
# Emit the webpack runtime as a file instead of inlining it into index.html,
# so the Content Security Policy can forbid inline scripts.
INLINE_RUNTIME_CHUNK=false
# Do not publish source maps with the production build.
GENERATE_SOURCEMAP=false
