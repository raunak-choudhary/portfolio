/node_modules
/.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
/coverage
.nyc_output

# Production build output is kept locally for Hostinger uploads.
# It is ignored by git because it can be regenerated with `npm run build`.

# Environment Variables - Keep these secret!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Supabase
.supabase/

# Superpowers local runtime scratch space
.superpowers/

# Database files
*.db
*.sqlite

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# System files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Log files
*.log

# Build outputs
build/
dist/

# Temporary folders
tmp/
temp/

# Agent and tooling local files
.claude/
.codex/
AGENTS.md
graphify-out/
.superpowers/

# Secrets (baseline): every env file except the example
.env.*
!.env.example

# Agent source of truth (local only)
CLAUDE.md

