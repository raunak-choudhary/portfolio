# Apache and LiteSpeed configuration for raunakchoudhary.com on Hostinger.
# Create React App copies this file into build/, so the deployed site always
# carries the same rules the browser suite tested (scripts/static-server.mjs
# reads the Header lines below and applies them locally).
#
# Sections:
#   1. Canonical origin: https and www.
#   2. Single-page app routing: real files are served, every other path
#      falls back to index.html so client-side routes work on reload.
#   3. Security headers, including the Content Security Policy. The policy is
#      the single source of truth: there is deliberately no CSP meta tag in
#      index.html, because a meta copy can only tighten the header and drift.
#   4. Caching: hashed assets are immutable; index.html is always revalidated
#      so a new deploy is picked up immediately.
#
# scripts/check-csp.mjs asserts the policy below allows every asset host the
# site uses and forbids inline and eval script.

# 1. Canonical origin
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off
  RewriteRule ^ https://www.raunakchoudhary.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^raunakchoudhary\.com$ [NC]
  RewriteRule ^ https://www.raunakchoudhary.com%{REQUEST_URI} [R=301,L]

  # 2. Single-page app routing
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# 3. Security headers
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://emaaaeooafqawdvdreaz.supabase.co https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://emaaaeooafqawdvdreaz.supabase.co wss://emaaaeooafqawdvdreaz.supabase.co; frame-src 'self' https://emaaaeooafqawdvdreaz.supabase.co; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # 4. Caching
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.[0-9a-f]{8}\.(js|css)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
